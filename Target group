resource "aws_lb_target_group" "web" {
  name     = "web-target-group"
  port     = 80
  protocol = "HTTP"

  vpc_id = aws_vpc.main.id

  health_check {
    enabled  = true
    path     = "/"
    protocol = "HTTP"
    port     = "traffic-port"
  }

  tags = {
    Name        = "Portfolio-Web-TG"
    Environment = "Lab"
    ManagedBy   = "Terraform"
  }
}
